# .env에서는 코드 끝에 공백이나 코드 옆에 주석도 달면 안된다.

# ------------- <Django 내부적으로 사용하는 암호화 키> -------------
# 절대 외부에 노출되면 안 됨
# 세션, 쿠키 서명, 비밀번호 해싱 등 보안 기능에 사용
SECRET_KEY=django-insecure-=vk2)8q6*!_3)96rh%q&!^c7y@df9yhq!zjt&-=&@^s*xiti


# ------------- <Django가 접속을 허용할 호스트/도메인 목록> -------------
# 쉼표로 여러 개를 작성할 수 있음
# localhost -> 로컬 접속 허용
# 127.0.0.1 -> 로컬 IP
# 0.0.0.0 -> 모든 IP 허용 (개발용)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.trycloudflare.com


# -----------------------------------------------------------------
# True -> 개발 모드
# False -> 운영 모드
# True일 때는 오류 페이지가 상세하게 표시되지만 보안상 위험. 운영 서버에서는 반드시 DEBUG=False로 변경 해야한다.
DEBUG=False


# ------------------------- NAVER SMTP -------------------------
# NAVER_USER: Django가 네이버 SMTP 서버에 로그인할 때 사용할 인증 계정
# NAVER_APP_PAS: 네이버 앱 비밀번호 (2단계 인증을 위해 네이버에서 따로 발급)
NAVER_USER=leehk00002@naver.com
NAVER_APP_PASS=GRVVZUQKHSC7


# ------------- <프론트엔드 비밀번호 재설정 URL> -------------
# 프론트엔드 사이트의 기본 주소 (도메인)
# - 개발 환경: http://127.0.0.1:5173
# - 운영 환경: https://company.com
FRONTEND_BASE_URL=https://tape-called-grey-drain.trycloudflare.com

# 프론트엔드에서 비밀번호 재설정 페이지 라우트 경로
PASSWORD_RESET_PATH=/change-password


# ------------------------- DB 설정 -------------------------
# 사용할 DB 엔진 선택
# 기본값: SQLite -> django.db.backends.sqlite3
#         MySQL -> django.db.backends.mysql
# DB_NAME: 데이터베이스 파일명 또는 이름
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3  


# Django 백엔드에서 AWS S3 및 CloudFront와 연결하기 위해 사용되는 환경 변수
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=company-site-media
AWS_ACCESS_KEY_ID=AKIAQIEZCQXBM7K2UMFM
AWS_SECRET_ACCESS_KEY=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
CLOUDFRONT_DOMAIN=d1r4ens1ykyl8r.cloudfront.net


# ===== Cookies (서브도메인/HTTPS 운영 권장) =====
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None

